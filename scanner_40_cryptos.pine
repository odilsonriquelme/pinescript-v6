// ── Filtro ──────────────────────────────────────────────────────────────────
filter_enabled = input.bool(false, '',
     group   = '🔎 Filtro',
     inline  = 'Filter',
     tooltip = 'Ativa o filtro de exibição. Quando ligado, só aparecem na tabela os ativos cujo valor da coluna selecionada esteja dentro do intervalo "De / Até".')

filter_column = input.string('Price',
     title   = 'Coluna',
     options = ['Price', 'RSI', 'TSI', 'ADX', 'SuperTrend'],
     group   = '🔎 Filtro',
     inline  = 'Filter',
     tooltip = 'Coluna usada como critério do filtro.\n• Price → preço atual\n• RSI / TSI / ADX → valores dos indicadores\n• SuperTrend → direção (-1 = alta, 1 = baixa)')

filter_from = input.float(-9999999, 'De',
     group   = '🔎 Filtro',
     inline  = 'Filter',
     tooltip = 'Valor mínimo do filtro (inclusivo). Ex: RSI ≥ 30')

filter_to = input.float(9999999, 'Até',
     group   = '🔎 Filtro',
     inline  = 'Filter',
     tooltip = 'Valor máximo do filtro (inclusivo). Ex: RSI ≤ 70')

// ── RSI ─────────────────────────────────────────────────────────────────────
rsi_len = input.int(14,
     title   = 'Período',
     group   = '📊 RSI',
     minval  = 1,
     tooltip = 'Número de candles usados no cálculo do RSI. Padrão clássico: 14.')

rsi_os = input.float(30,
     title   = 'Sobrevenda (verde)',
     group   = '📊 RSI',
     minval  = 0, maxval = 100,
     tooltip = 'Abaixo deste valor o RSI é considerado sobrevendido → célula fica VERDE.')

rsi_ob = input.float(70,
     title   = 'Sobrecompra (vermelho)',
     group   = '📊 RSI',
     minval  = 0, maxval = 100,
     tooltip = 'Acima deste valor o RSI é considerado sobrecomprado → célula fica VERMELHA.')

// ── TSI ─────────────────────────────────────────────────────────────────────
tsi_long_len = input.int(25,
     title   = 'Período Longo',
     group   = '📈 TSI',
     minval  = 1,
     tooltip = 'Período da primeira EMA do TSI (suavização longa). Padrão: 25.')

tsi_shrt_len = input.int(13,
     title   = 'Período Curto',
     group   = '📈 TSI',
     minval  = 1,
     tooltip = 'Período da segunda EMA do TSI (suavização curta). Padrão: 13.')

tsi_ob = input.float(30,
     title   = 'Sobrecompra (vermelho)',
     group   = '📈 TSI',
     tooltip = 'Acima deste valor o TSI indica sobrecompra → célula fica VERMELHA.')

tsi_os = input.float(-30,
     title   = 'Sobrevenda (verde)',
     group   = '📈 TSI',
     tooltip = 'Abaixo deste valor o TSI indica sobrevenda → célula fica VERDE.')

// ── ADX ─────────────────────────────────────────────────────────────────────
adx_smooth = input.int(14,
     title   = 'Suavização',
     group   = '📉 ADX',
     minval  = 1,
     tooltip = 'Período de suavização do ADX (RMA). Padrão: 14.')

adx_dilen = input.int(14,
     title   = 'Período DI',
     group   = '📉 ADX',
     minval  = 1,
     tooltip = 'Período para calcular as linhas DI+ e DI-. Padrão: 14.')

adx_level = input.float(40,
     title   = 'Nível de força (verde)',
     group   = '📉 ADX',
     minval  = 0,
     tooltip = 'Acima deste valor considera-se tendência forte → célula fica VERDE.\nAbaixo indica mercado lateral ou tendência fraca.')

// ── SuperTrend ───────────────────────────────────────────────────────────────
sup_atr_len = input.int(10,
     title   = 'Período ATR',
     group   = '🚀 SuperTrend',
     minval  = 1,
     tooltip = 'Período do ATR usado no cálculo do SuperTrend. Padrão: 10.')

sup_factor = input.float(3.0,
     title   = 'Fator multiplicador',
     group   = '🚀 SuperTrend',
     minval  = 0.1, step = 0.1,
     tooltip = 'Multiplica o ATR para definir a banda do SuperTrend.\nValores maiores → menos sensível / menos sinais.\nValores menores → mais sensível / mais sinais.')

